#!/usr/bin/env bash
set -euo pipefail
# Runs governor.sh under sh against plain files that stand in for the two sysfs files, with a
# 1-second interval, and checks each switch it should (and should not) make.
# The status tag, coloured only on a terminal and never with NO_COLOR set.
if [[ -t 1 && -z ${NO_COLOR-} ]]; then
	ok_tag=$'\033[90m[\033[38;5;154m  OK  \033[90m]\033[0m'
else
	ok_tag='[  OK  ]'
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_root=$(mktemp -d /tmp/amdgpu-boost.XXXXXX)
pid=''
cleanup() {
	if [[ -n $pid ]]; then kill "$pid" 2>/dev/null || true; fi
	rm -rf -- "$test_root"
}
trap cleanup EXIT

busy=$test_root/gpu_busy_percent
level=$test_root/power_dpm_force_performance_level
log=$test_root/log
export BUSY_FILE=$busy LEVEL_FILE=$level INTERVAL=1 BUSY_PCT=20 BUSY_SAMPLES=2 IDLE_PCT=10 IDLE_SECONDS=2 READ_FAILS=2

ok() { printf ' %s %s\n' "$ok_tag" "$1"; }
fail() {
	printf ' [FAIL] %s\n' "$1" >&2
	if [[ -s $log ]]; then sed 's/^/   | /' "$log" >&2; fi
	exit 1
}
gov=$script_dir/governor.sh
# Polls for up to 5 seconds until the level file reads $1.
level_becomes() {
	local i
	for ((i = 0; i < 50; i++)); do
		[[ $(<"$level") == "$1" ]] && return 0
		sleep 0.1
	done
	fail "level is '$(<"$level")' after 5s, expected '$1' ($2)"
}
# Fails if the level file stops reading $1 within $2 seconds.
level_stays() {
	local i
	for ((i = 0; i < $2 * 10; i++)); do
		[[ $(<"$level") == "$1" ]] || fail "level changed to '$(<"$level")', expected it to stay '$1' ($3)"
		sleep 0.1
	done
}

# Startup checks: both refuse to run and exit 1.
echo 0 >"$busy"
echo auto >"$level"
if BUSY_FILE=$test_root/missing sh "$gov" >"$log" 2>&1; then fail 'started without a busy file'; fi
grep -q 'cannot read' "$log" || fail 'no error for a missing busy file'
ok 'exits when the busy file is unreadable'
if LEVEL_FILE=$test_root/missing/level sh "$gov" >"$log" 2>&1; then fail 'started without a writable level file'; fi
grep -q 'is not writable' "$log" || fail 'no error for an unwritable level file'
ok 'exits when the level file is not writable'

# A run through each switch.
echo high >"$level"
sh "$gov" >"$log" 2>&1 &
pid=$!
level_becomes auto 'reset at start'
grep -q 'started: high after 2x1s' "$log" || fail 'no start line with the settings'
ok 'resets the level to auto at start'

echo 50 >"$busy"
level_becomes high 'two busy samples'
ok 'switches to high after the busy samples'

echo 15 >"$busy"
level_stays high 4 'load between IDLE_PCT and BUSY_PCT is not idle'
ok 'stays high while load is between the thresholds'

echo 'not a number' >"$busy"
level_becomes auto 'unreadable sample counts as idle'
ok 'switches back to auto after the idle time (bad readings count as idle)'

echo 50 >"$busy"
level_becomes high 'busy again'
kill -TERM "$pid"
for ((i = 0; i < 30; i++)); do
	kill -0 "$pid" 2>/dev/null || break
	sleep 0.1
done
kill -0 "$pid" 2>/dev/null && fail 'still running 3s after TERM'
status=0
wait "$pid" || status=$?
pid=''
[[ $status -eq 0 ]] || fail "exited $status on TERM, expected 0"
[[ $(<"$level") == auto ]] || fail "level is '$(<"$level")' after TERM, expected 'auto'"
ok 'puts the level back to auto and exits 0 on TERM'

# A busy file that disappears mid-run, as after a driver reload: exits 1 so Docker restarts it.
echo 50 >"$busy"
sh "$gov" >"$log" 2>&1 &
pid=$!
level_becomes high 'busy before the file goes'
rm -- "$busy"
for ((i = 0; i < 50; i++)); do
	kill -0 "$pid" 2>/dev/null || break
	sleep 0.1
done
kill -0 "$pid" 2>/dev/null && fail 'still running 5s after the busy file went'
status=0
wait "$pid" || status=$?
pid=''
[[ $status -eq 1 ]] || fail "exited $status after failed reads, expected 1"
grep -q 'failed reads' "$log" || fail 'no error for the failed reads'
[[ $(<"$level") == auto ]] || fail "level is '$(<"$level")' after failed reads, expected 'auto'"
ok 'puts the level back to auto and exits 1 after failed reads in a row'
